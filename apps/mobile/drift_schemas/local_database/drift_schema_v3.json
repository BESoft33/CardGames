    {
      "name": "log_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"log_events\" (\"event_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"match_id\" TEXT NOT NULL, \"seq\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"envelope\" TEXT NOT NULL, \"hash\" TEXT NOT NULL, \"sync_state\" TEXT NOT NULL, PRIMARY KEY (\"event_id\"), UNIQUE (\"match_id\", \"seq\"));"
        }
      ]
    },
    {
      "name": "matches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"matches\" (\"match_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"game_id\" TEXT NOT NULL, \"rules_version\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"last_seq\" INTEGER NOT NULL, \"last_hash\" TEXT NOT NULL, \"acked_seq\" INTEGER NOT NULL DEFAULT -1, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"match_id\"));"
        }
      ]
    },
    {
      "name": "meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"user_id\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"user_id\", \"key\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"profile_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"remote_user_id\" TEXT NULL, \"display_name\" TEXT NULL, \"confirmed_balance\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\"));"
        }
      ]
    },
    {
      "name": "match_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"match_summaries\" (\"match_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"game_id\" TEXT NOT NULL, \"stake\" INTEGER NOT NULL, \"result\" TEXT NOT NULL, \"coins\" INTEGER NOT NULL, \"settled_at\" INTEGER NOT NULL, PRIMARY KEY (\"match_id\"));"
